# Backend Environment Variables - DO NOT COMMIT THIS FILE
# Copy to .env and fill in YOUR actual values
GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql://user:password@postgres:5432/bitewise_db
