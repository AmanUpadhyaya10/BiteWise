# BACKEND - Add these to Railway environment variables

# Groq AI
GROQ_API_KEY=your_groq_api_key_here

# Database (auto-generated by Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Storage paths (Railway)
UPLOADS_DIR=/app/app/storage/uploads
TRAINING_DIR=/app/app/storage/dataset/train
LOGS_DIR=/app/logs

# Cloudinary (for image storage)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Server configuration
PORT=8000
ENVIRONMENT=production

---

# FRONTEND - Add these to Vercel environment variables

VITE_API_URL=https://your-railway-backend.up.railway.app

---

# LOCAL DEV - Create .env file in backend root

GROQ_API_KEY=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
DATABASE_URL=sqlite:///./foodscan.db
