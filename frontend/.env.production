TRAINING_DIR=app/storage/dataset/train
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

---

# HOW TO FIND YOUR VALUES:

# CLOUDINARY_NAME: Dashboard → Settings → Cloud Name
# CLOUDINARY_API_KEY: Dashboard → API Keys → API Key
# CLOUDINARY_API_SECRET: Dashboard → API Keys → API Secret

# RAILWAY_DATABASE_URL: After creating PostgreSQL service, Railway shows it in the environment
# RAILWAY_BACKEND_URL: After deploying backend, check Railway dashboard for the URL